{
  "name": "gphoto",
  "version": "0.1.0",
  "description": "Google Photos CLI",
  "type": "module",
  "bin": {
    "gphoto": "./src/main.ts"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && bun test",
    "prepublishOnly": "tsc --noEmit && bun test"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "files": [
    "src",
    "README.md",
    "tsconfig.json"
  ],
  "devDependencies": {
    "bun-types": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "google-photos",
    "cli",
    "photos",
    "upload",
    "download"
  ],
  "dependencies": {
    "citty": "^0.2.2"
  }
}
